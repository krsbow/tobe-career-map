# Supabase Configuration
# Obtain from your Supabase Dashboard: Project Settings > API
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY = "your-supabase-service-role-key-optional"

# AI / LLM Configuration (Provider options: "gemini", "groq", "openai", "fallback")
LLM_PROVIDER = "gemini"

# Google Gemini API Key (Optional: system provides graceful fallback if empty)
GEMINI_API_KEY = "your-gemini-api-key"

# Alternative LLM Provider Keys
GROQ_API_KEY = ""
OPENAI_API_KEY = ""

# Application Settings
APP_ENV = "development"
DEMO_MODE = true # Set to true to allow local offline exploration without active Supabase backend
